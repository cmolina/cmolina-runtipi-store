{
  "schemaVersion": 2,
  "services": [
    {
      "name": "isponsorblocktv",
      "image": "ghcr.io/dmunozv04/isponsorblocktv:v2.11.0",
      "networkMode": "host",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/app/data"
        }
      ]
    },
    {
      "name": "isponsorblocktv-terminal",
      "image": "ghcr.io/cmolina/isponsorblocktv-ttyd:v2.11.0",
      "isMain": true,
      "internalPort": 7681,
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/app/data"
        }
      ],
      "healthCheck": {
        "test": "wget -q --spider http://127.0.0.1:7681/",
        "interval": "10s",
        "retries": 5,
        "startPeriod": "10s",
        "timeout": "10s"
      }
    }
  ]
}

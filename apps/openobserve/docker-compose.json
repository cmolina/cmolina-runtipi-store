{
  "schemaVersion": 2,
  "services": [
    {
      "name": "openobserve",
      "image": "openobserve/openobserve:v1.0.0",
      "isMain": true,
      "internalPort": 5080,
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/openobserve",
          "containerPath": "/data"
        }
      ],
      "environment": [
        { "key": "ZO_ROOT_USER_EMAIL", "value": "${ZO_ROOT_USER_EMAIL}" },
        { "key": "ZO_ROOT_USER_PASSWORD", "value": "${ZO_ROOT_USER_PASSWORD}" },
        { "key": "ZO_DATA_DIR", "value": "/data" },
        { "key": "ZO_LOCAL_MODE", "value": "true" },
        { "key": "ZO_TELEMETRY", "value": "${ZO_TELEMETRY}" },
        { "key": "TZ", "value": "${TZ}" }
      ],
      "restart": "always"
    }
  ]
}
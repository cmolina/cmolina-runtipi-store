{
  "schemaVersion": 2,
  "services": [
    {
      "name": "portkey",
      "image": "portkeyai/gateway:1.15.2",
      "isMain": true,
      "internalPort": 8787,
      "environment": [
        { "key": "PORT", "value": "8787" }
      ],
      "restart": "unless-stopped",
      "healthCheck": {
        "test": "wget -q --spider http://127.0.0.1:8787/",
        "interval": "10s",
        "retries": 5,
        "startPeriod": "10s",
        "timeout": "10s"
      }
    }
  ]
}
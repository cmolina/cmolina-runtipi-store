{
  "schemaVersion": 2,
  "services": [
    {
      "name": "bentopdf",
      "image": "ghcr.io/alam00000/bentopdf-simple:2.8.7",
      "isMain": true,
      "internalPort": 8080,
      "environment": [
        { "key": "DISABLE_IPV6", "value": "${DISABLE_IPV6}" },
        { "key": "DISABLE_TOOLS", "value": "${DISABLE_TOOLS}" }
      ]
    }
  ]
}

{
  "schemaVersion": 2,
  "services": [
    {
      "name": "bentopdf",
      "image": "ghcr.io/alam00000/bentopdf-simple:2.8.11",
      "isMain": true,
      "internalPort": 8080,
      "environment": [
        { "key": "DISABLE_IPV6", "value": "${DISABLE_IPV6}" },
        { "key": "DISABLE_TOOLS", "value": "${DISABLE_TOOLS}" }
      ],
      "healthCheck": {
        "test": "wget -q --spider http://127.0.0.1:8080/",
        "interval": "10s",
        "retries": 5,
        "startPeriod": "10s",
        "timeout": "10s"
      }
    }
  ]
}

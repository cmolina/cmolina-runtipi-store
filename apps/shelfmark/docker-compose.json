{
  "schemaVersion": 2,
  "services": [
    {
      "name": "shelfmark",
      "image": "ghcr.io/calibrain/shelfmark:v1.5.1",
      "isMain": true,
      "internalPort": 8084,
      "environment": [
        {"key": "PUID", "value": "${PUID}"},
        {"key": "PGID", "value": "${PGID}"},
        {"key": "TIMEZONE", "value": "${TIMEZONE}"},
        {"key": "DOCKERMODE", "value": "true"},
        {"key": "CONFIG_DIR", "value": "/config"},
        {"key": "INGEST_DIR", "value": "/books"},
        {"key": "DISABLE_LOCAL_AUTH", "value": "${DISABLE_LOCAL_AUTH}"},
        {"key": "SHELFMARK_API_KEY", "value": "${SHELFMARK_API_KEY}"},
        {"key": "SHELFMARK_API_KEY_READONLY", "value": "${SHELFMARK_API_KEY_READONLY}"}
      ],
      "volumes": [
        {"hostPath": "${APP_DATA_DIR}/data/config", "containerPath": "/config"},
        {"hostPath": "${ROOT_FOLDER_HOST}/media/data/books", "containerPath": "/books"}
      ]
    }
  ]
}
